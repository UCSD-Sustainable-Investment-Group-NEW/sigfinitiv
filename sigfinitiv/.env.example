# Copy this file to .env and fill in your own values. Never commit .env.

# Analysts: your personal read-only database login
SIGFINITIVE_DB_USER=
SIGFINITIVE_DB_PASSWORD=

# Optional overrides (most people leave these unset)
# SIGFINITIVE_DB_HOST=
# SIGFINITIVE_DB_NAME=

# Services (the API) or pointing at a dev branch: a full connection string.
# When set, this is used instead of the user/password above.
# SIGFINITIVE_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
